# Supabase (required)
# Local Docker: use `.env.local` overrides (see docs/supabase.md). Never set SUPABASE_PROJECT_ID
# to your cloud ref — the CLI treats it as the local Docker project name.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-key
VITE_SUPABASE_PROJECT_ID=your-project-id

# Local Cursor work: create `.env.local` that overrides URLs/keys to:
#   SUPABASE_URL=http://127.0.0.1:54321
#   VITE_SUPABASE_URL=http://127.0.0.1:54321
#   (+ anon / service_role from `npm run db:start`)
# Full guide: docs/supabase.md

# AI providers — cheap-first (Lovable gateway NOT required for local/self-host)
# Order: gemini → groq → moonshot → xai → freellm → openai → lovable
# Override with: AI_PROVIDER_ORDER=gemini,xai,groq
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
MOONSHOT_API_KEY=
MOONSHOT_MODEL=kimi-k2.5
XAI_API_KEY=
XAI_MODEL=grok-3-mini
FREELLM_API_KEY=
FREELLM_BASE_URL=
FREELLM_MODEL=auto
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=
OPENAI_IMAGE_MODEL=dall-e-3
# Legacy only (optional)
LOVABLE_API_KEY=
AI_PROVIDER_ORDER=gemini,groq,moonshot,xai,freellm


# x402 machine payments (required in production)
# Platform USDC receiver for agent/API settlement. Prefer an explicit treasury address.
# If unset, the app falls back to OKX_PAYOUT_ADDRESS. Deploy does not sync .env — set on VPS too.
X402_PAY_TO=
X402_NETWORK=base-sepolia
X402_FACILITATOR_URL=https://x402.org/facilitator
# Set to 1 to allow simulated settlement / agent buys without facilitator-valid EIP-3009
# Legacy flag — unpaid/dev settlement is automatic in non-production and never allowed in production
X402_ALLOW_DEV=

# Smart wallets / Alchemy Account Kit (Light Account)
# APP_USER_CONNECTION_KEY_SECRET encrypts per-user owner keys + session keys (32-byte base64)
APP_USER_CONNECTION_KEY_SECRET=
ALCHEMY_API_KEY=
# Optional explicit RPC URL — must match ALCHEMY_NETWORK (base-sepolia or base-mainnet)
ALCHEMY_BASE_URL=
ALCHEMY_NETWORK=base-sepolia
# Gas Manager policy ID — enables sponsored UserOps / deploy-on-first-use
ALCHEMY_GAS_POLICY_ID=
VITE_CHAIN_NETWORK=base-sepolia
# Legacy only — old deterministic derivation; new wallets use encrypted random keys
WALLET_DERIVATION_SECRET=

# OKX DEX rails (server-only — not a member wallet)
OKX_API_KEY=
OKX_SECRET_KEY=
OKX_PASSPHRASE=
OKX_BUILDER_CODE=
OKX_PAYOUT_ADDRESS=

# Mailbox connectors (Lovable app-user)
GOOGLE_MAIL_APP_USER_CONNECTOR_CLIENT_API_KEY=
MICROSOFT_OUTLOOK_APP_USER_CONNECTOR_CLIENT_API_KEY=
# SMTP uses per-user encrypted secrets (host/port/user/pass) — no app-wide SMTP env.
# Requires APP_USER_CONNECTION_KEY_SECRET (32-byte base64) already used for OAuth keys.

# Research
FIRECRAWL_API_KEY=
# Optional: set to 1 to route Firecrawl via Lovable connector (needs LOVABLE_API_KEY too).
# FIRECRAWL_USE_LOVABLE=1
# Without FIRECRAWL_API_KEY, Lead Hunter uses a DuckDuckGo + fetch fallback.

# Stripe billing (optional — unlocks fiat checkout)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_COMPANY=
STRIPE_PRICE_SCALE=
# One-time $99 founding seat (separate from AURA compute subscriptions)
STRIPE_PRICE_FOUNDING_SEAT=
STRIPE_PRICE_LOCAL_SEAT=
STRIPE_PRICE_BOOST_SICHTBARKEIT=
STRIPE_PRICE_BOOST_BEWERTUNGEN=
STRIPE_PRICE_BOOST_NEUKUNDEN=
# Ops key to mint Barzahlung Local Seat codes (server-only)
LOCAL_SEAT_OPS_KEY=
# Optional Genesis Passport NFT (fiat checkout) — separate from founding seat + token launch
STRIPE_PRICE_GENESIS_NFT=
GENESIS_NFT_CONTRACT=
VITE_GENESIS_NFT_CONTRACT=
GENESIS_NFT_PRICE_USDC=99
GENESIS_NFT_MAX_SUPPLY=1000
# Server-only hex key with MINTER_ROLE (never VITE_*). Prefer Sepolia first.
GENESIS_MINTER_KEY=
# Optional demo end-customer products (Horoscope / Tarot Daily on /s/…)
STRIPE_PRICE_HOROSCOPE_DAILY=
STRIPE_PRICE_TAROT_DAILY=
# Non-web3 funnel outcome / Business-in-a-Box SKUs (€)
STRIPE_PRICE_OUTCOME_STARTER=
STRIPE_PRICE_OUTCOME_GROWTH=
STRIPE_PRICE_OUTCOME_PERFORMANCE=
STRIPE_PRICE_BIB_SETUP=
STRIPE_PRICE_BIB_OPERATE_STARTER=
STRIPE_PRICE_BIB_OPERATE_GROWTH=
STRIPE_PRICE_BIB_OPERATE_SCALE=
VITE_STRIPE_PUBLISHABLE_KEY=

# Social OAuth — one-click connect for Channels
X_CLIENT_ID=
X_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Aliases also accepted: LINKEDIN_APP_ID / LINKEDIN_APP_SECRET
# Set LINKEDIN_SHARE_SCOPE=1 only after "Share on LinkedIn" product is approved
# (adds w_member_social; without it, connect still works via OpenID).
LINKEDIN_SHARE_SCOPE=
META_APP_ID=
META_APP_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Farcaster via Neynar
# API key alone → cast search, channel feeds, user lookup (Channels → Farcaster pulse)
# Preferred write path: approved agent/bot signer → one-click Connect + cast/reply
NEYNAR_API_KEY=
NEYNAR_CLIENT_ID=
NEYNAR_AGENT_ID=
# Alias for NEYNAR_AGENT_ID if you prefer the generic name
NEYNAR_SIGNER_UUID=
# Your Farcaster FID (NEYNAR_UID is accepted as an alias)
NEYNAR_FARCASTER_FID=
NEYNAR_UID=
NEYNAR_WALLET_ID=
NEYNAR_WALLET_ADDRESS=
NEYNAR_RPC_URL=
# Optional classic managed-signer path (Warpcast approve) when no agent signer:
# Hex private key of the custody address that owns NEYNAR_FARCASTER_FID / NEYNAR_UID
NEYNAR_CUSTODY_PRIVATE_KEY=
OAUTH_REDIRECT_BASE=https://aibusiness.fun
# Redirect URI to register at LinkedIn / Meta / X / TikTok:
#   {OAUTH_REDIRECT_BASE}/api/oauth/social/callback
# Local (vite): http://localhost:4000/api/oauth/social/callback
# See docs/social-channels.md

# Background worker (/api/workers/tick)
WORKER_SECRET=

# App
VITE_APP_ENV=development
SITE_URL=https://aibusiness.fun
