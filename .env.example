# Supabase (required)
# Local Docker: use `.env.local` overrides (see docs/supabase.md). Never set SUPABASE_PROJECT_ID
# to your cloud ref — the CLI treats it as the local Docker project name.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-key
VITE_SUPABASE_PROJECT_ID=your-project-id

# Local Cursor work: create `.env.local` that overrides URLs/keys to:
#   SUPABASE_URL=http://127.0.0.1:54321
#   VITE_SUPABASE_URL=http://127.0.0.1:54321
#   (+ anon / service_role from `npm run db:start`)
# Full guide: docs/supabase.md

# Platform ops panel (/ops) — comma-separated founder emails
OPS_ADMIN_EMAILS=

# AI providers — cheap-first (Lovable gateway NOT required for local/self-host)
# Order: freellm (FreeLLMAPI stacked free tiers) → moonshot → gemini → groq → xai → …
# Run FreeLLMAPI locally (or SSH -L 3001:127.0.0.1:3001 to the VPS router).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# Product / marketing stills (Nano Banana). Falls back to OPENAI_IMAGE_MODEL if unset.
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
MOONSHOT_API_KEY=
MOONSHOT_MODEL=kimi-k3
XAI_API_KEY=
XAI_MODEL=grok-3-mini
FREELLM_API_KEY=freellmapi-your-unified-key
FREELLM_BASE_URL=http://127.0.0.1:3001/v1
FREELLM_MODEL=auto
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=
OPENAI_IMAGE_MODEL=dall-e-3
# Legacy only (optional)
LOVABLE_API_KEY=
AI_PROVIDER_ORDER=freellm,groq,gemini,moonshot,openai,xai


# x402 machine payments (required in production)
# Platform USDC receiver for agent/API settlement. Prefer an explicit treasury address.
# If unset, the app falls back to OKX_PAYOUT_ADDRESS. Deploy does not sync .env — set on VPS too.
X402_PAY_TO=
# x402 EIP-3009 settlement network: base | base-sepolia (BSC uses Base settle until a BSC facilitator ships)
X402_NETWORK=base
X402_FACILITATOR_URL=https://x402.org/facilitator
# Set to 1 to allow simulated settlement / agent buys without facilitator-valid EIP-3009
# Legacy flag — unpaid/dev settlement is automatic in non-production and never allowed in production
X402_ALLOW_DEV=

# Smart wallets / Alchemy Account Kit (Light Account) — multichain
# APP_USER_CONNECTION_KEY_SECRET encrypts per-user owner keys + session keys (32-byte base64)
APP_USER_CONNECTION_KEY_SECRET=
ALCHEMY_API_KEY=
# Optional explicit RPC URL — must match ALCHEMY_NETWORK (base | base-sepolia | bsc | opbnb)
# Prefer ALCHEMY_RPC_URL; ALCHEMY_BASE_URL kept as alias for Base deploys.
ALCHEMY_RPC_URL=
ALCHEMY_BASE_URL=
# Active default desk/wallet chain when company has no desk_network yet:
# base | base-sepolia | bsc | opbnb | robinhood | robinhood-testnet
# Per-company override: companies.desk_network + Wallet/Trading chain switcher
# DESK_NETWORKS=base,bsc,robinhood
ALCHEMY_NETWORK=base
# Gas Manager policy IDs (create one per Alchemy network in the dashboard)
ALCHEMY_GAS_POLICY_ID=
ALCHEMY_GAS_POLICY_ID_BASE=
ALCHEMY_GAS_POLICY_ID_BSC=
ALCHEMY_GAS_POLICY_ID_OPBNB=
ALCHEMY_GAS_POLICY_ID_ROBINHOOD=
VITE_CHAIN_NETWORK=base
# Keep x402 on Base even when the Quant desk is on BSC / Robinhood
X402_NETWORK=base
# RETIRE after migration — do not set on mainnet. Legacy deterministic derivation only.
# WALLET_DERIVATION_SECRET=

# OKX DEX rails (server-only — not a member wallet)
OKX_API_KEY=
OKX_SECRET_KEY=
OKX_PASSPHRASE=
# Optional Web3 project id (OK-ACCESS-PROJECT header for Trade API v6)
OKX_PROJECT_ID=
OKX_BUILDER_CODE=
OKX_PAYOUT_ADDRESS=
# Optional referrer fee % on swaps (must be > 0 and ≤ 3). Omit for zero fee.
# Never set to 0 — OKX rejects feePercent=0. Requires OKX_PAYOUT_ADDRESS.
# OKX_FEE_PERCENT=0.85

# Mailbox connectors (Lovable app-user)
GOOGLE_MAIL_APP_USER_CONNECTOR_CLIENT_API_KEY=
MICROSOFT_OUTLOOK_APP_USER_CONNECTOR_CLIENT_API_KEY=
# SMTP uses per-user encrypted secrets (host/port/user/pass) — no app-wide SMTP env.
# Requires APP_USER_CONNECTION_KEY_SECRET (32-byte base64) already used for OAuth keys.

# Research
FIRECRAWL_API_KEY=
# Optional: set to 1 to route Firecrawl via Lovable connector (needs LOVABLE_API_KEY too).
# FIRECRAWL_USE_LOVABLE=1
# Without FIRECRAWL_API_KEY, Lead Hunter uses a DuckDuckGo + fetch fallback.

# Stripe billing (optional — unlocks fiat checkout)
STRIPE_SECRET_KEY=
# Managed Payments (Stripe as merchant of record) — default on. Set 0 to disable.
# Site sales via Connect use direct charges and skip Managed Payments automatically.
STRIPE_MANAGED_PAYMENTS=1
STRIPE_WEBHOOK_SECRET=
# Connect SaaS (founders sell on their own Stripe). Accounts API preview version.
STRIPE_CONNECT_API_VERSION=2026-07-29.preview
STRIPE_CONNECT_DEFAULT_COUNTRY=AT
STRIPE_PRICE_STARTER=
STRIPE_PRICE_COMPANY=
STRIPE_PRICE_SCALE=
# One-time $99 founding seat (separate from AURA compute subscriptions)
STRIPE_PRICE_FOUNDING_SEAT=
STRIPE_PRICE_LOCAL_SEAT=
STRIPE_PRICE_AURA_REPUTATION=
STRIPE_PRICE_BOOST_SICHTBARKEIT=
STRIPE_PRICE_BOOST_BEWERTUNGEN=
STRIPE_PRICE_BOOST_NEUKUNDEN=
# Ops key to mint Barzahlung Local Seat codes (server-only)
LOCAL_SEAT_OPS_KEY=
# Optional Genesis Passport NFT (fiat checkout) — separate from founding seat + token launch
STRIPE_PRICE_GENESIS_NFT=
GENESIS_NFT_CONTRACT=
VITE_GENESIS_NFT_CONTRACT=
GENESIS_NFT_PRICE_USDC=99
GENESIS_NFT_MAX_SUPPLY=1000
# Server-only hex key with MINTER_ROLE (never VITE_*). Prefer Sepolia first.
GENESIS_MINTER_KEY=
# Optional demo end-customer products (Horoscope / Tarot Daily on /s/…)
STRIPE_PRICE_HOROSCOPE_DAILY=
STRIPE_PRICE_TAROT_DAILY=
# Non-web3 funnel outcome / Business-in-a-Box SKUs (€)
STRIPE_PRICE_OUTCOME_STARTER=
STRIPE_PRICE_OUTCOME_GROWTH=
STRIPE_PRICE_OUTCOME_PERFORMANCE=
STRIPE_PRICE_BIB_SETUP=
STRIPE_PRICE_BIB_OPERATE_STARTER=
STRIPE_PRICE_BIB_OPERATE_GROWTH=
STRIPE_PRICE_BIB_OPERATE_SCALE=
VITE_STRIPE_PUBLISHABLE_KEY=

# Social OAuth — one-click connect for Channels
X_CLIENT_ID=
X_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Aliases also accepted: LINKEDIN_APP_ID / LINKEDIN_APP_SECRET
# Set LINKEDIN_SHARE_SCOPE=1 only after "Share on LinkedIn" product is approved
# (adds w_member_social; without it, connect still works via OpenID).
LINKEDIN_SHARE_SCOPE=
META_APP_ID=
META_APP_SECRET=
# Instagram Content Publishing is requested in the OAuth scope list automatically.
# Reconnect Meta once after deploy so long-lived user token is stored for Page refresh.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# TikTok: Login Kit + Content Posting API; scopes user.info.basic,video.upload,video.publish
# Redirect: {OAUTH_REDIRECT_BASE}/api/oauth/social/callback — see docs/social-channels.md
# Farcaster via Neynar
# API key alone → cast search, channel feeds, user lookup (Channels → Farcaster pulse)
# Preferred write path: approved agent/bot signer → one-click Connect + cast/reply
NEYNAR_API_KEY=
NEYNAR_CLIENT_ID=
NEYNAR_AGENT_ID=
# Alias for NEYNAR_AGENT_ID if you prefer the generic name
NEYNAR_SIGNER_UUID=
# Your Farcaster FID (NEYNAR_UID is accepted as an alias)
NEYNAR_FARCASTER_FID=
NEYNAR_UID=
NEYNAR_WALLET_ID=
NEYNAR_WALLET_ADDRESS=
NEYNAR_RPC_URL=
# Optional classic managed-signer path (Warpcast approve) when no agent signer:
# Hex private key of the custody address that owns NEYNAR_FARCASTER_FID / NEYNAR_UID
NEYNAR_CUSTODY_PRIVATE_KEY=
OAUTH_REDIRECT_BASE=https://aibusiness.fun
# Redirect URI to register at LinkedIn / Meta / X / TikTok:
#   {OAUTH_REDIRECT_BASE}/api/oauth/social/callback
# Local (vite): http://localhost:4000/api/oauth/social/callback
# See docs/social-channels.md

# Background worker (/api/workers/tick)
WORKER_SECRET=

# App
VITE_APP_ENV=development
SITE_URL=https://aibusiness.fun

# FIO Protocol (primary crypto-handle rail — see docs/FIO.md)
FIO_TPID=
FIO_DOMAIN=aura
FIO_REGISTER_URL=https://www.fio.net/
FIO_API_URL=
VITE_FIO_TPID=
VITE_FIO_DOMAIN=aura
VITE_FIO_REGISTER_URL=https://www.fio.net/

# Company Token Launch Desk (Clanker on Base) — optional per-company ERC-20
# Separate from platform fair-launch AURA and in-app compute credits.
CLANKER_ENABLED=false
# Platform share of LP fee rewards in bps (10000 = 100%). Default 5%.
CLANKER_PLATFORM_FEE_BPS=500
