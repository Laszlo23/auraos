# Production Caddy for aibusiness.fun
# Install: cp deploy/Caddyfile /etc/caddy/Caddyfile && systemctl reload caddy
#
# MP4s are served from /opt/auraos/public (gitignored). That directory tree must
# be traversable by the caddy user: `chmod 755 /opt/auraos /opt/auraos/public`.
# Never put long immutable Cache-Control on *.mp4 — a 403 would be sticky for a week.

aibusiness.fun, www.aibusiness.fun {
  encode gzip zstd
  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    X-Content-Type-Options nosniff
    Referrer-Policy strict-origin-when-cross-origin
    Permissions-Policy "camera=(), microphone=(), geolocation=()"
    -Server
  }

  # Hashed/static assets only (not mp4 — errors must not be cached immutable).
  # Exclude service worker so updates are not stuck behind a week-long cache.
  @static {
    path *.js *.css *.woff2 *.jpg *.jpeg *.png *.webp *.svg *.ico
    not path /sw.js
  }
  header @static Cache-Control "public, max-age=604800, immutable"

  @pwa path /sw.js /manifest.webmanifest /offline.html
  header @pwa Cache-Control "public, max-age=0, must-revalidate"
  header @pwa Service-Worker-Allowed "/"

  # HTML/API traffic only — static assets would drown page-view counts.
  @skip_access_log path_regexp \.(js|css|mjs|map|woff2?|ttf|eot|png|jpe?g|gif|webp|svg|ico|mp4|webm)$
  log_skip @skip_access_log
  log_skip /assets*
  log_skip /api*
  log_skip /_serverFn*
  log_skip /sw.js

  log {
    output file /var/lib/caddy/logs/aibusiness.access.log {
      mode 0640
      roll_size 100MiB
      roll_keep 14
      roll_keep_for 14d
    }
    format json
  }

  redir /share-kit /share 308
  redir /whitepaper/de /whitepaper?lang=de 302

  # Kit videos + posters live on disk (too large for Nitro build / git).
  @media path *.mp4 /share/*
  handle @media {
    root * /opt/auraos/public
    file_server
  }

  # NOWPayments IPN — only their notification servers (go-live checklist).
  @cryptoIpnBlocked {
    path /api/billing/crypto-ipn
    not remote_ip 51.89.194.21 51.75.77.69 138.201.172.58 65.21.158.36 127.0.0.1
  }
  respond @cryptoIpnBlocked 403

  reverse_proxy 127.0.0.1:3000
}

# Aura Lokal — do not remove. OS deploys overwrite this file.
import /etc/caddy/sites/*
