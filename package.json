{
  "name": "auraos",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "npm@11.16.0",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && node scripts/fix-start-manifest.mjs",
    "build:dev": "vite build --mode development",
    "build:vps": "NITRO_PRESET=node-server vite build && node scripts/fix-start-manifest.mjs",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:grants": "vitest run src/lib/grant-kit.test.ts",
    "test:devices": "AURA_LIVE_SMOKE=1 vitest run src/lib/device-smoke.test.ts src/lib/device-smoke.live.test.ts",
    "ci": "npm test && npx eslint src --max-warnings 200 && npm run build",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:status": "supabase status -o pretty",
    "db:reset": "supabase db reset",
    "db:env": "bash scripts/supabase-env.sh",
    "db:cutover": "bash scripts/supabase-cutover.sh"
  },
  "dependencies": {
    "@aa-sdk/core": "^4.88.4",
    "@account-kit/infra": "^4.88.4",
    "@account-kit/smart-contracts": "^4.88.4",
    "@ai-sdk/openai": "^4.0.41",
    "@ai-sdk/react": "^4.0.67",
    "@lovable.dev/cloud-auth-js": "^1.1.2",
    "@neynar/nodejs-sdk": "^3.177.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.4",
    "@supabase/supabase-js": "^2.112.3",
    "@tailwindcss/vite": "^4.2.1",
    "@tanstack/react-query": "^5.101.1",
    "@tanstack/react-router": "^1.170.27",
    "@tanstack/react-start": "^1.168.44",
    "@tanstack/router-plugin": "^1.168.30",
    "ai": "^7.0.64",
    "clanker-sdk": "^4.2.18",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^0.575.0",
    "mem0ai": "^3.1.6",
    "motion": "^12.43.0",
    "nodemailer": "^9.0.5",
    "ox": "^1.6.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.1",
    "tw-animate-css": "^1.3.4",
    "viem": "^2.55.13",
    "vite-tsconfig-paths": "^6.0.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@lovable.dev/vite-tanstack-config": "2.15.0",
    "@types/node": "^22.16.5",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.2.6",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^15.15.0",
    "nitro": "3.0.260603-beta",
    "prettier": "^3.7.3",
    "supabase": "^2.114.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.56.1",
    "vite": "^8.1.5",
    "vitest": "^3.2.7"
  },
  "overrides": {
    "jayson": {
      "uuid": "^11.1.1"
    },
    "h3": "2.0.1-rc.26",
    "unstorage": {
      "lru-cache": "11.5.2"
    },
    "@metamask/utils": {
      "uuid": "^11.1.1"
    },
    "ws": "^8.20.2"
  }
}
