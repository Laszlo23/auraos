# Large local media mirrors (download via scripts/fetch-media.sh;
# ship share-kit clips with scripts/deploy-share-media.sh — too large for git).
# Keep posters/images tracked; video stays local + VPS-synced.
public/*.mp4
!public/.gitkeep

